# Recado 环境变量示例
#
# 复制为 `.env` 后填写真实值。全部变量在进程启动时经 Zod 校验，
# 缺失或格式错误会直接拒绝启动并逐项列出问题（见 apps/server/src/config/env.server.ts）。
#
# ⚠️ 本文件只放占位值，不要提交任何真实密钥。

# ---------- 运行 ----------

# development | test | production
NODE_ENV=development

# HTTP 监听端口
PORT=3000

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# ---------- 数据库 ----------

# PostgreSQL 16+ 连接串。迁移是独立部署步骤（pnpm db:migrate），不在应用启动时自动执行。
DATABASE_URL=postgres://recado:recado@localhost:5432/recado

# ---------- 密钥 ----------

# 管理台会话 token 的签名密钥，至少 32 字符
SESSION_SECRET=change-me-session-secret-at-least-32-characters

# 站点级 SMTP 密码等落库密钥的加密根密钥，至少 32 字符。
# 丢失后需要重新填写所有站点的 SMTP 密码。
SECRETS_KEY=change-me-secrets-key-at-least-32-characters

# ---------- OIDC（参考实现：ZITADEL，见决策 D14）----------

OIDC_ISSUER_URL=https://idp.example.com
OIDC_CLIENT_ID=recado
OIDC_CLIENT_SECRET=change-me
OIDC_REDIRECT_URI=http://localhost:3000/auth/callback

# 角色名前缀：<前缀>.OWNER = 实例管理员，<前缀>.ADMIN.<站点 UUID> = 站点管理员
OIDC_ROLE_PREFIX=recado

# 角色所在的 claim 路径，默认 roles；兼容 groups 与 Keycloak 的嵌套写法（realm_access.roles）
OIDC_ROLE_CLAIM=roles

# Bearer token 的受众（aud）校验值；留空则用 OIDC_CLIENT_ID。
# 不校验受众的话，同一 IdP 下别的客户端签发的 token 也能调管理 API。
# OIDC_AUDIENCE=

# 管理台会话有效期（小时，默认 168 = 7 天）。
# 权限快照存在会话里，因此这也决定 IdP 撤销角色后最晚多久生效。
SESSION_TTL_HOURS=168
