{
  "name": "recado",
  "version": "0.0.0",
  "private": true,
  "description": "自托管、多站点、Headless 的评论系统",
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @recado/server dev",
    "build": "pnpm --filter @recado/server build",
    "start": "pnpm --filter @recado/server start",
    "typecheck": "pnpm -r --no-bail typecheck",
    "test": "pnpm -r --no-bail test",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check",
    "db:generate": "pnpm --filter @recado/db generate",
    "db:migrate": "pnpm --filter @recado/db migrate",
    "prepare": "node scripts/setup-hooks.mjs"
  },
  "devDependencies": {
    "@types/node": "26.6.2",
    "oxfmt": "0.70.0",
    "oxlint": "1.85.0",
    "oxlint-tsgolint": "7.0.2002",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.4.1"
}
